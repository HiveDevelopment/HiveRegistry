{
    "id": "discord-bot",
    "name": "Discord Bot Hosting",
    "category": "bot",
    "group": "discord",
    "tags": [
        "runtime",
        "nodejs",
        "javascript"
    ],
    "capabilities": [
        "console",
        "files",
        "logs",
        "environment",
        "allocations",
        "sftp",
        "backups",
        "schedules"
    ],
    "image": "node:22-alpine",
    "working_dir": "/home/container",
    "entrypoint": [],
    "environment": {
        "TZ": "UTC",
        "NODE_ENV": "production"
    },
    "mounts": [
        {
            "source": "instance",
            "target": "/home/container"
        }
    ],
    "startup": "{{startup_command}}",
    "variables_schema": [
        {
            "name": "startup_command",
            "type": "string",
            "default": "node index.js",
            "required": true
        }
    ],
    "install": [],
    "game": "discord",
    "preinstalls": [
        "discord-tickets",
        "discord-tickets-source"
    ],
    "recommended_resources": {
        "memory_mb": 256,
        "disk_mb": 1024,
        "cpu_percent": 50
    }
}
