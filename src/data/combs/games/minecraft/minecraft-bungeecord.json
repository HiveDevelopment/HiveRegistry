{
  "id": "minecraft-bungeecord",
  "name": "Minecraft BungeeCord",
  "category": "game",
  "group": "minecraft",
  "game": "minecraft",
  "tags": [
    "minecraft",
    "bungeecord",
    "proxy"
  ],
  "capabilities": [
    "console",
    "files",
    "logs",
    "environment",
    "allocations",
    "sftp",
    "backups",
    "schedules"
  ],
  "image": "ghcr.io/hivedevelopment/hivepanel-java:25",
  "docker_images": {
    "Java 25": "ghcr.io/hivedevelopment/hivepanel-java:25",
    "Java 21": "ghcr.io/hivedevelopment/hivepanel-java:21",
    "Java 8": "ghcr.io/hivedevelopment/hivepanel-java:8"
  },
  "working_dir": "/home/container",
  "entrypoint": [],
  "environment": {
    "TZ": "UTC"
  },
  "mounts": [
    {
      "source": "instance",
      "target": "/home/container"
    }
  ],
  "startup": "java -Xms{{memory}}M -Xmx{{memory}}M -jar BungeeCord.jar",
  "variables_schema": [
    {
      "name": "memory",
      "type": "number",
      "default": 512,
      "required": true
    }
  ],
  "install": [
    {
      "type": "download",
      "with": {
        "url": "https://ci.md-5.net/job/BungeeCord/lastSuccessfulBuild/artifact/bootstrap/target/BungeeCord.jar",
        "target": "BungeeCord.jar"
      }
    }
  ],
  "recommended_resources": {
    "memory_mb": 256,
    "disk_mb": 1024,
    "cpu_percent": 50
  }
}
