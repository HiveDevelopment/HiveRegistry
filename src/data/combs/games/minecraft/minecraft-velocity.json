{
  "id": "minecraft-velocity",
  "name": "Minecraft Velocity",
  "category": "game",
  "group": "minecraft",
  "game": "minecraft",
  "tags": [
    "minecraft",
    "velocity",
    "proxy"
  ],
  "capabilities": [
    "console",
    "files",
    "logs",
    "environment",
    "allocations",
    "sftp",
    "backups",
    "schedules"
  ],
  "image": "ghcr.io/hivedevelopment/hivepanel-java:25",
  "working_dir": "/home/container",
  "entrypoint": [],
  "environment": {
    "TZ": "UTC"
  },
  "mounts": [
    {
      "source": "instance",
      "target": "/home/container"
    }
  ],
  "startup": "java -Xms{{memory}}M -Xmx{{memory}}M -jar velocity.jar",
  "variables_schema": [
    {
      "name": "memory",
      "type": "number",
      "default": 512,
      "required": true
    },
    {
      "name": "version",
      "type": "string",
      "default": "3.4.0-SNAPSHOT",
      "required": true
    }
  ],
  "install": [
    {
      "type": "http",
      "with": {
        "url": "https://fill.papermc.io/v3/projects/velocity/versions/{{version}}/builds"
      },
      "save": "velocity_builds"
    },
    {
      "type": "download",
      "with": {
        "url": "{{velocity_builds.0.downloads.server:default.url}}",
        "target": "velocity.jar"
      }
    }
  ]
}
